{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "madong/stepcore/schema/route-graph-v2.json",
  "title": "MES Route Graph v2",
  "description": "工艺路线图像 JSON v2：业务参数统一放在 properties，节点以 node_key 定位，变迁以 from_node_key/to_node_key 描述。",
  "type": "object",
  "required": ["schema_version", "meta", "nodes", "transitions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "meta": {
      "type": "object",
      "required": ["code", "version"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "graph_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "saved_at": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/definitions/transition" }
    },
    "layout": {
      "type": "object",
      "properties": {
        "nodes": { "type": "object" },
        "viewport": { "type": "object" },
        "groups": { "type": "array" }
      },
      "additionalProperties": false
    },
    "extensions": { "type": "object" }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["node_key", "type", "name", "properties"],
      "additionalProperties": false,
      "properties": {
        "node_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "maxLength": 128 },
        "properties": { "type": "object" },
        "steps": { "type": "array", "items": { "$ref": "#/definitions/step" } },
        "ext": { "type": "object" }
      }
    },
    "step": {
      "type": "object",
      "required": ["step_key", "properties"],
      "additionalProperties": false,
      "properties": {
        "step_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "properties": {
          "type": "object",
          "properties": {
            "content": { "type": "string" },
            "device_params": { "type": "object" },
            "attachments": { "type": "array" }
          },
          "additionalProperties": true
        }
      }
    },
    "transition": {
      "type": "object",
      "required": ["edge_key", "from_node_key", "to_node_key", "mode", "properties"],
      "additionalProperties": false,
      "properties": {
        "edge_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "from_node_key": { "type": "string", "minLength": 1 },
        "to_node_key": { "type": "string", "minLength": 1 },
        "mode": {
          "type": "string",
          "enum": ["straight", "branch", "join", "rework", "conditional", "event", "timer", "rollback", "jump", "cancel"]
        },
        "properties": { "$ref": "#/definitions/transitionProperties" },
        "ext": { "type": "object" }
      }
    },
    "transitionProperties": {
      "type": "object",
      "properties": {
        "trigger": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["manual", "auto", "auto_ng", "event", "timer", "threshold", "rollback", "reversal"]
            },
            "event_name": { "type": "string" },
            "delay_seconds": { "type": "integer", "minimum": 0 },
            "metric": { "type": "string" }
          },
          "additionalProperties": true
        },
        "condition": {
          "type": "object",
          "properties": {
            "expr": { "type": ["string", "null"] },
            "rules": { "type": "array", "items": { "type": "object" } }
          },
          "additionalProperties": true
        },
        "priority": { "type": "integer" },
        "weight": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "join_policy": { "type": "string", "enum": ["all", "any"] },
        "guards": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "array", "items": { "type": "string" } },
        "label": { "type": "string" },
        "style": { "type": "object" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
